# ─── Embedding server ──────────────────────────────────────────────────────────
# llama.cpp server running the embedding GGUF model locally.
# Start with:
#   llama-server.exe -m nomic-embed-text-v2-moe-Q4_K_M.gguf --embedding --pooling mean --port 8003
LEGAL_AGENT_LLAMA_CPP_URL=http://127.0.0.1:8003

# Name sent in the /v1/embeddings request body — must match what the model expects
LEGAL_AGENT_EMBEDDING_MODEL=nomic-embed-text-v2-moe

# Output vector dimension of the embedding model (nomic-embed-text-v2-moe = 768)
LEGAL_AGENT_EMBEDDING_DIM=768

# ─── Qdrant ────────────────────────────────────────────────────────────────────
# URL of the running Qdrant instance (Docker or remote)
# Production (Qdrant Cloud): https://xyz-example.eu-central.aws.cloud.qdrant.io
QDRANT_URL=http://localhost:6333

# Qdrant Cloud API key — leave empty for local/Docker, required for Qdrant Cloud
# Obtain from: https://cloud.qdrant.io → your cluster → API Keys
QDRANT_API_KEY=

# Qdrant collection name used by the legal agent
QDRANT_COLLECTION=crime_os

# ─── Embedding backend ─────────────────────────────────────────────────────────
# 'auto'   → BGE (if cached) → Nomic (llama.cpp)  [development default]
# 'gemini' → Gemini text-embedding-004 API         [set in production]
# Obtain Gemini API key from: https://aistudio.google.com/apikey
EMBEDDING_BACKEND=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
