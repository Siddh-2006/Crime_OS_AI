# Prompt Compression Service — Environment Variables
# Copy this file to .env and fill in values as needed.

# Host / port (defaults used when running with uvicorn directly)
HOST=0.0.0.0
PORT=8005

# (Optional) HuggingFace cache directory — avoids re-downloading the model
# HF_HOME=/path/to/hf_cache
# TRANSFORMERS_CACHE=/path/to/hf_cache

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
