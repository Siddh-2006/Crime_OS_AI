# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="Crime OS AI Recommendation Service"
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── Qdrant Vector Database ──────────────────────────────────────────────────
# Production (Qdrant Cloud): https://xyz-example.eu-central.aws.cloud.qdrant.io
QDRANT_URL=http://localhost:6333

# Qdrant Cloud API key — leave empty for local/Docker, required for Qdrant Cloud
# Obtain from: https://cloud.qdrant.io → your cluster → API Keys
QDRANT_API_KEY=

QDRANT_COLLECTION=crime_fir_embeddings

# ── llama.cpp Embedding Server ──────────────────────────────────────────────
# URL pointing to llama-server run with nomic-embed-text-v2-moe GGUF model
LLAMA_CPP_URL=http://localhost:8080
EMBEDDING_MODEL=nomic-embed-text-v2-moe
