# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/crime_os

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_EXPIRY_SECONDS=604800

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET=your_cookie_secret_change_in_production

# ─── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Crime OS Gujarat Police <noreply@gujaratpolice.gov.in>

# ─── BullMQ ────────────────────────────────────────────────────────────────────
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=

# ─── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── AI Services ───────────────────────────────────────────────────────────────
COMPLAINT_INTELLIGENCE_URL=http://localhost:8001
LEGAL_AGENT_URL=http://localhost:8004
IO_RECOMMENDATION_URL=http://localhost:8003
TRANSLATION_SERVICE_URL=http://localhost:8010
TRANSLATION_TIMEOUT_MS=30000

# ─── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
OLLAMA_REQUIRED_MODELS=gemma4:e4b,llama3.2:latest

# ─── Sarvam-1 via llama-server (DISABLED — kept for reference) ────────────────
# Start with: llama-server -m sarvam-1.Q8_0.gguf -c 8192 --port 8004
SARVAM_BASE_URL=http://localhost:8005
SARVAM_MODEL=sarvam-1
SARVAM_MAX_CTX=8192
SARVAM_TIMEOUT_MS=600000

# ─── Gemini (cloud fallback when Ollama is unavailable) ───────────────────────
# Get API key from: https://aistudio.google.com/apikey
# Used automatically when Ollama/gemma4:e2b is unreachable
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Gmail OAuth2 (department request emails + response polling) ───────────────
# GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
# Generate via: https://developers.google.com/oauthplayground with gmail.readonly + gmail.modify + gmail.metadata scopes
GMAIL_REFRESH_TOKEN=your_refresh_token
# The Gmail address that sends requests and receives department responses
GMAIL_POLICE_EMAIL=your_police_gmail@gmail.com
# How often to poll for new reply emails in milliseconds (default: 60000 = 60 seconds)
GMAIL_POLL_INTERVAL_MS=60000
