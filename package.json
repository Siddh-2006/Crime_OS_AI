{
  "name": "crime-os-ai-platform",
  "version": "1.0.0",
  "description": "Crime OS AI Platform — Multi-service Startup Suite",
  "scripts": {
    "dev": "start-dev.bat",
    "dev:ps1": "powershell -ExecutionPolicy Bypass -File .\\start-dev.ps1",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "service:complaint": "cd services/complaint_intelligence && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8001",
    "service:io": "cd services/io-recommendation && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "service:florence": "cd services/florence_service && .venv\\Scripts\\python.exe -m uvicorn app:app --host 0.0.0.0 --port 8002",
    "service:legal": "cd services/legal_agent && venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8003"
  }
}
